                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Front Leg outline, drawn in side profile: x = depth (front at 0), y = height.\n * The leg rakes forward at the foot; foot and top are cut level.\n */\nfunction run(\n  legWidth: number = 100,\n  legHeight: number = 508,\n  rake: number = 80,\n): Assembly {\n  const outline = replicad\n    .draw([0, 0])\n    .lineTo([legWidth, 0])\n    .lineTo([legWidth + rake, legHeight])\n    .lineTo([rake, legHeight])\n    .close();\n  return new Assembly({ geometry: outline });\n}",
                  "compiledCode": "\"use strict\";\n/**\n * Front Leg outline, drawn in side profile: x = depth (front at 0), y = height.\n * The leg rakes forward at the foot; foot and top are cut level.\n */\nfunction run(legWidth = 100, legHeight = 508, rake = 80) {\n    const outline = replicad\n        .draw([0, 0])\n        .lineTo([legWidth, 0])\n        .lineTo([legWidth + rake, legHeight])\n        .lineTo([rake, legHeight])\n        .close();\n    return new Assembly({ geometry: outline });\n}\n"
