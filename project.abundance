                    {
                      "name": "frontBottom",
                      "ioValue": 200
                    },
                    {
                      "name": "frontTop",
                      "ioValue": 356
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Side Panel outline, drawn in side profile: x = depth (front at 0, back at +),\n * y = height above the floor. The panel's rear tip and a long skid sit on the floor,\n * and it rises diagonally to the front leg where it carries the seat front.\n */\nfunction run(\n  depth: number = 889,\n  skidFront: number = 430,\n  frontY: number = 60,\n  frontBottom: number = 200,\n  frontTop: number = 356,\n): Assembly {\n  const outline = replicad\n    .draw([depth, 0])\n    .lineTo([skidFront, 0])\n    .lineTo([frontY, frontBottom])\n    .lineTo([frontY, frontTop])\n    .close();\n  return new Assembly({ geometry: outline });\n}",
                  "compiledCode": "\"use strict\";\n/**\n * Side Panel outline, drawn in side profile: x = depth (front at 0, back at +),\n * y = height above the floor. The panel's rear tip and a long skid sit on the floor,\n * and it rises diagonally to the front leg where it carries the seat front.\n */\nfunction run(depth = 889, skidFront = 430, frontY = 60, frontBottom = 200, frontTop = 356) {\n    const outline = replicad\n        .draw([depth, 0])\n        .lineTo([skidFront, 0])\n        .lineTo([frontY, frontBottom])\n        .lineTo([frontY, frontTop])\n        .close();\n    return new Assembly({ geometry: outline });\n}\n"
                },
