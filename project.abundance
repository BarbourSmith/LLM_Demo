                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.2,
                  "y": 0.5,
                  "uniqueID": "id-1126678",
                  "ioValues": [
                    {
                      "name": "frontY",
                      "ioValue": 45
                    },
                    {
                      "name": "rearTipY",
                      "ioValue": 870
                    },
                    {
                      "name": "rearTopY",
                      "ioValue": 533
                    },
                    {
                      "name": "rearTopZ",
                      "ioValue": 213
                    },
                    {
                      "name": "frontTopZ",
                      "ioValue": 333
                    },
                    {
                      "name": "frontBottomZ",
                      "ioValue": 180
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Side Panel outline, drawn in side profile: x = depth (front at 0, back at +),\n * y = height above the floor. A wide diagonal plank: its top edge carries the\n * seat slats, its rear end is cut square to the back recline and touches the floor\n * at the rear tip, and its front end is cut vertical behind the seat apron.\n */\nfunction run(\n  rearTipY: number = 870,\n  rearTopY: number = 533,\n  rearTopZ: number = 213,\n  frontY: number = 45,\n  frontTopZ: number = 333,\n  frontBottomZ: number = 180,\n): Assembly {\n  const outline = replicad\n    .draw([rearTipY, 0])\n    .lineTo([rearTopY, rearTopZ])\n    .lineTo([frontY, frontTopZ])\n    .lineTo([frontY, frontBottomZ])\n    .close();\n  return new Assembly({ geometry: outline });\n}",
                  "compiledCode": "\"use strict\";\n/**\n * Side Panel outline, drawn in side profile: x = depth (front at 0, back at +),\n * y = height above the floor. A wide diagonal plank: its top edge carries the\n * seat slats, its rear end is cut square to the back recline and touches the floor\n * at the rear tip, and its front end is cut vertical behind the seat apron.\n */\nfunction run(rearTipY = 870, rearTopY = 533, rearTopZ = 213, frontY = 45, frontTopZ = 333, frontBottomZ = 180) {\n    const outline = replicad\n        .draw([rearTipY, 0])\n        .lineTo([rearTopY, rearTopZ])\n        .lineTo([frontY, frontTopZ])\n        .lineTo([frontY, frontBottomZ])\n        .close();\n    return new Assembly({ geometry: outline });\n}\n"
                },
